# Database connection
DATABASE_URL=postgresql://user:password@localhost:5432/campus_thrift

# JWT Authentication
# Required: The server will fail to start if JWT_SECRET_KEY is not set.
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_local_environment

# Optional: Token expiration in minutes (defaults to 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
